<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Wendrick Guilherme da Silva Batista | Perfil profissional</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F6F7FB; --surface:#FFFFFF; --ink:#18202E; --muted:#566075; --line:#DFE3EC;
  --accent:#2F5BFF; --accent-ink:#FFFFFF; --hi:#FFC93C; --hi-ink:#18202E;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#10141C; --surface:#182030; --ink:#EEF1F7; --muted:#A3ACBF; --line:#2A3448;
    --accent:#7C9BFF; --accent-ink:#10141C; color-scheme:dark;
  }
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Space Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.6;font-size:17px}
.wrap{max-width:720px;margin:0 auto;padding:0 20px 56px}
.cover{height:120px;margin:0 -20px;background:var(--accent);position:relative;overflow:hidden}
.cover::after{content:"";position:absolute;right:-30px;top:-30px;width:150px;height:150px;border-radius:50%;background:var(--hi)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px;margin-top:16px}
.head{margin-top:-56px;position:relative}
.avatar{width:112px;height:112px;border-radius:50%;object-fit:cover;display:block;border:4px solid var(--bg);background:var(--hi)}
h1{font-size:28px;line-height:1.15;margin:14px 0 6px;letter-spacing:-.02em}
.headline{margin:0;color:var(--muted);font-size:17px}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.tag{border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:14px;color:var(--muted)}
h2{font-size:20px;margin:0 0 4px;letter-spacing:-.01em}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
p{margin:0 0 12px;max-width:62ch}
.job{padding:16px 0;border-top:1px solid var(--line)}
.job:first-of-type{border-top:0;padding-top:4px}
.job h3{font-size:18px;margin:0}
.job .meta{color:var(--muted);font-size:15px;margin:0 0 8px}
ul{margin:0;padding-left:20px}
li{margin-bottom:6px;max-width:62ch}
.skills{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.skills li{margin:0;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-size:15px}
</style>
</head>
<body>
<div class="wrap">
  <div class="cover" aria-hidden="true"></div>

  <header class="head">
    <img class="avatar" src="data:image/jpeg;base64,
